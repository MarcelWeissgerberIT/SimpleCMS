# ── SimpleCMS One server — copy to .env and fill in ──────────────────────────

# Your domain. Its DNS A/AAAA record must point to this server.
# docker compose derives PUBLIC_URL=https://$DOMAIN from it.
DOMAIN=cloud.example.com

# 32+ random bytes, hex or base64. Generate with:  openssl rand -hex 32
# Keep it secret and stable: changing it signs everyone out and voids open links/invites.
SECRET=

# Master key for encryption at rest: exactly 32 random bytes. Generate with:  openssl rand -base64 32
# Every workspace's content is encrypted with its own key, wrapped by this one. Store a copy in your
# password manager — NOT next to the backups (a backup is unreadable without it). Must differ from SECRET.
# Never edit it to change it: rotate with  node dist/cli.js rotate-data-key  (docs/SELF_HOSTING.md).
DATA_KEY=

# Outgoing mail for sign-in links and invitations (any SMTP provider).
#   smtps://USER:PASSWORD@smtp.example.com:465     (TLS)
#   smtp://USER:PASSWORD@smtp.example.com:587      (STARTTLS)
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F).
# Empty = dev-mail mode: links are only written to the server log (docker compose logs one).
SMTP_URL=
MAIL_FROM="SimpleCMS One <no-reply@example.com>"

# Who may create an account:
#   open                         anyone with an email address
#   invite                       only addresses with an invitation or a registration link
#   domains:example.com,example.de   these email domains (plus anyone invited or holding a registration link)
SIGNUP=invite

# Server admins, comma-separated, e.g. ADMIN_EMAILS=you@yourcompany.com,it@yourcompany.com
# They may always create their account (no CLI needed) and create registration links in the app
# (Settings → Server) — links that let people sign up on an invite-only server without being invited
# to a workspace. Empty = no server admins.
ADMIN_EMAILS=

# Upload limit per file, in MB.
MAX_UPLOAD_MB=25

# Public API (docs/API.md): requests per minute per API token and per incoming webhook.
# API_RATE_LIMIT=120

# Custom agents on the server (docs/CLOUD.md § Agents) need outbound HTTPS to api.anthropic.com;
# each workspace brings its own Claude key (Settings in the app). Switch the runner off with AGENTS=off.
# AGENTS=on
# AGENT_CONCURRENCY=4
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# AGPL-3.0 §13: link to the source code of the server you run. Change it if you modify the server.
# SOURCE_URL=https://github.com/you/your-fork
