# Runtime-only image from clean, previously verified production build artifacts.
# Context: dist/, server/dist/, server/package.json, server/LICENSE, server/README.md.
# Copy only its immutable assets for tabs still running an earlier build.
# The final stage must not inherit the previous release's repeated filesystem layers.
ARG COMPAT_IMAGE
FROM ${COMPAT_IMAGE} AS previous_assets
FROM node:22-slim
ENV NODE_ENV=production \
    NODE_OPTIONS="--disable-warning=ExperimentalWarning --enable-source-maps" \
    PORT=8080 \
    DATA_DIR=/data \
    APP_DIR=/app/dist
WORKDIR /app/server
COPY --from=previous_assets /app/dist/assets/ /app/dist/assets/
COPY dist/ /app/dist/
COPY server/dist/ ./dist/
COPY server/package.json server/LICENSE server/README.md ./
RUN mkdir -p /data && chown node:node /data && chmod -R a+rX /app
USER node
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["node", "dist/index.js"]
