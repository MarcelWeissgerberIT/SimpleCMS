{
  "url": "https://openrouter.ai/api/v1/chat/completions",
  "body": {
    "model": "vendor-a/model-b",
    "messages": [
      {
        "role": "system",
        "content": "You are the writing assistant."
      },
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "<text>\nThe launch is friday\n</text>\n\nTask: Fix spelling."
          }
        ]
      }
    ],
    "stream": true,
    "max_tokens": 8000,
    "provider": {
      "only": [
        "nordwind",
        "lindenhof/turbo"
      ],
      "allow_fallbacks": false,
      "data_collection": "deny",
      "require_parameters": true
    },
    "plugins": [
      {
        "id": "web",
        "enabled": false
      },
      {
        "id": "context-compression",
        "enabled": false
      },
      {
        "id": "response-healing",
        "enabled": false
      }
    ]
  },
  "headers": {
    "Content-Type": "application/json",
    "HTTP-Referer": "https://one.example/app/",
    "X-OpenRouter-Title": "One",
    "X-OpenRouter-App-Visibility": "hidden"
  }
}
