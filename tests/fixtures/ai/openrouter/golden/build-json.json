{
  "model": "vendor-a/model-b",
  "messages": [
    {
      "role": "system",
      "content": "You are the writing assistant."
    },
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "<text>\nThe launch is friday\n</text>\n\nTask: Fix spelling."
        }
      ]
    }
  ],
  "stream": true,
  "max_tokens": 4096,
  "response_format": {
    "type": "json_schema",
    "json_schema": {
      "name": "answer",
      "schema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "rows"
        ],
        "additionalProperties": false
      },
      "strict": true
    }
  },
  "provider": {
    "only": [
      "nordwind",
      "lindenhof/turbo"
    ],
    "allow_fallbacks": false,
    "data_collection": "deny",
    "require_parameters": true
  },
  "plugins": [
    {
      "id": "web",
      "enabled": false
    },
    {
      "id": "context-compression",
      "enabled": false
    },
    {
      "id": "response-healing",
      "enabled": false
    }
  ]
}
