{
  "model": "vendor-c/thinker-2",
  "messages": [
    {
      "role": "system",
      "content": "You are the writing assistant."
    },
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "<text>\nThe launch is friday\n</text>\n\nTask: Fix spelling."
        }
      ]
    }
  ],
  "stream": true,
  "max_tokens": 16384,
  "reasoning": {
    "effort": "low"
  },
  "provider": {
    "only": [
      "nordwind",
      "lindenhof/turbo"
    ],
    "allow_fallbacks": false,
    "data_collection": "deny",
    "require_parameters": true
  },
  "plugins": [
    {
      "id": "web",
      "enabled": false
    },
    {
      "id": "context-compression",
      "enabled": false
    },
    {
      "id": "response-healing",
      "enabled": false
    }
  ]
}
